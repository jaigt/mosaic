# Google AI (Gemini) — optional now. Its free tier has a stingy daily request
# cap (~250/day on Flash) that blocks heavy building/demos; see the free
# alternatives below. Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic / Claude (optional — needed for claude-* models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (optional — needed for gpt-* / o1 / o3 / o4 models)
OPENAI_API_KEY=your_openai_api_key_here

# ── Absolutely-free LLM providers (escape Gemini's stingy daily cap) ──────────
# These are OpenAI-compatible: prefix the model with "<provider>/" to use them,
# e.g. SYNTHESIS_MODEL="cerebras/llama-3.3-70b". All are no-credit-card free
# tiers far more generous than Gemini's daily cap:
#   Cerebras ~1M tokens/DAY    https://cloud.cerebras.ai      (fast, recommended)
#   Groq     ~1k req/day        https://console.groq.com/keys (fastest streaming)
#   Mistral  ~1B tokens/MONTH   https://console.mistral.ai
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Ollama is fully local — no key, no limit, no signup. Install from
# https://ollama.com, `ollama pull qwen2.5`, then set models to "ollama/qwen2.5".
OLLAMA_BASE_URL=http://localhost:11434/v1
# oMLX / mlx_lm (Apple-Silicon local server, OpenAI-compatible). Fully local, no
# key, no limit. NOTE: oMLX defaults to :8000 which collides with this backend —
# set oMLX to another port (e.g. 8081) and match it here. Use via "mlx/<model>".
MLX_BASE_URL=http://localhost:8081/v1
# If oMLX's "API Key" verification is ON (Security tab), set this to that key.
# Leave empty if you disable key verification (dev only).
MLX_API_KEY=

# SEC EDGAR - required by SEC to identify your requests
# Use your real name and email to comply with SEC rate limit policy
SEC_USER_AGENT="Your Name your@email.com"

# LanceDB storage path (local disk)
LANCEDB_PATH=./data/lancedb

# Model config — swap any model from any provider just by changing the name.
# Provider is auto-detected by prefix:
#   claude-* | gemini-* | gpt-* | o1/o3/o4 | <provider>/<model>
# where <provider> ∈ cerebras, groq, mistral, ollama (see the free tiers above).
#
# FREE, no daily-cap pain (recommended for the POC) — pick one provider:
#   FAST_MODEL=cerebras/llama-3.3-70b
#   SYNTHESIS_MODEL=cerebras/llama-3.3-70b
# Or fully local / offline (no key at all):
#   FAST_MODEL=ollama/qwen2.5
#   SYNTHESIS_MODEL=ollama/qwen2.5
#
# Gemini defaults (works, but ~250 req/day on the free tier):
FAST_MODEL=gemini-2.5-flash-lite
SYNTHESIS_MODEL=gemini-2.5-flash

# Embeddings: Google (gemini-embedding-001, 3072-dim) or OpenAI
# (text-embedding-3-small 1536 / -large 3072). Anthropic has no embedding API.
# WARNING: the existing LanceDB table stores 3072-dim vectors — changing to a
# model with a different dimension requires deleting data/lancedb + re-ingest.
EMBEDDING_MODEL=local-bge-large
